@baseUrl = http://localhost:3000

###
# SETUP (только при пустой базе)
###

### Проверка статуса setup
GET {{baseUrl}}/api/setup/status

### Создание первого админа
# @name setup
POST {{baseUrl}}/api/setup
Content-Type: application/json

{
  "name": "Владелец",
  "email": "owner@example.com",
  "password": "secret123"
}

### Повторный вызов setup (ожидаем 409)
POST {{baseUrl}}/api/setup
Content-Type: application/json

{
  "name": "Хакер",
  "email": "hacker@example.com",
  "password": "secret123"
}

### Setup без пароля (ожидаем 400)
POST {{baseUrl}}/api/setup
Content-Type: application/json

{
  "name": "Без пароля",
  "email": "nopass@example.com"
}

###
# АУТЕНТИФИКАЦИЯ
###

### Логин админа (сохраняем ответ под именем login)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "owner@example.com",
  "password": "secret123"
}

### Refresh
POST {{baseUrl}}/api/auth/refresh

### Logout
POST {{baseUrl}}/api/auth/logout

### Извлекаем токен из ответа логина
@authToken = {{login.response.body.accessToken}}

### Логин с неверным паролем (ожидаем 401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "owner@example.com",
  "password": "wrongpassword"
}

### Логин несуществующего (ожидаем 401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "nobody@example.com",
  "password": "secret123"
}

###
# USERS (все защищены токеном)
###

### Смена пароля
PATCH {{baseUrl}}/api/users/me/password
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "currentPassword": "secret123",
  "newPassword": "newsecret456"
}

### Проверка: логин со старым паролем
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "owner@example.com",
  "password": "secret123"
}

### Проверка: логин с новым паролем
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "owner@example.com",
  "password": "newsecret456"
}

### Неверный текущий пароль (ожидаем 401)
PATCH {{baseUrl}}/api/users/me/password
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "currentPassword": "wrongpassword",
  "newPassword": "newsecret789"
}

### Короткий новый пароль (ожидаем 400)
PATCH {{baseUrl}}/api/users/me/password
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "currentPassword": "newsecret456",
  "newPassword": "123"
}


### Новый пароль совпадает со старым (ожидаем 400)
PATCH {{baseUrl}}/api/users/me/password
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "currentPassword": "newsecret456",
  "newPassword": "newsecret456"
}

### Без токена (ожидаем 401)
PATCH {{baseUrl}}/api/users/me/password
Content-Type: application/json

{
  "currentPassword": "newsecret456",
  "newPassword": "newsecret789"
}





### Получить свой профиль (под админом)
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{authToken}}

### Сброс пароля без токена (ожидаем 401)
PATCH {{baseUrl}}/api/users/3/password
Content-Type: application/json

{
  "newPassword": "hacked123"
}

### Короткий пароль (ожидаем 400)
PATCH {{baseUrl}}/api/users/3/password
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "newPassword": "123"
}

### Сброс пароля админом
PATCH {{baseUrl}}/api/users/3/password
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "newPassword": "brandnew789"
}

### Новый пароль совпадает со старым (ожидаем 400)
PATCH {{baseUrl}}/api/users/3/password
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "newPassword": "brandnew789"
}

### Проверить, что новый пароль работает
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "operator@example.com",
  "password": "brandnew789"
}

### Проверить, что старый пароль больше не работает
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "actor@example.com",
  "password": "secret123"
}

### Получить свой профиль под обычным пользователем 
# Cначала залогиниться под operator
# @name usLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "operator@example.com",
  "password": "secret123"
}

###

@userToken = {{usLogin.response.body.accessToken}}
 
### Потом получить профиль под operator
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{userToken}}


### Сброс пароля обычным пользователем (ожидаем 403)
PATCH {{baseUrl}}/api/users/3/password
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "newPassword": "hacked123"
}



### Все пользователи
GET {{baseUrl}}/api/users
Authorization: Bearer {{authToken}}

### Все пользователи без токена (ожидаем 401)
GET {{baseUrl}}/api/users

### Один пользователь по id
GET {{baseUrl}}/api/users/2
Authorization: Bearer {{authToken}}

### Несуществующий пользователь (ожидаем 404)
GET {{baseUrl}}/api/users/999
Authorization: Bearer {{authToken}}

### Некорректный id (ожидаем 400)
GET {{baseUrl}}/api/users/abc
Authorization: Bearer {{authToken}}

### Создание обычного пользователя (админом)
POST {{baseUrl}}/api/users
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Оператор",
  "email": "operator@example.com",
  "password": "secret123"
}

### Создание пользователя с ролью ADMIN
POST {{baseUrl}}/api/users
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Второй админ",
  "email": "admin2@example.com",
  "password": "secret123",
  "systemRole": "ADMIN"
}

### Создание с дублирующимся email (ожидаем 409)
POST {{baseUrl}}/api/users
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Дубль",
  "email": "operator@example.com",
  "password": "secret123"
}

### Создание без пароля (ожидаем 400)
POST {{baseUrl}}/api/users
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Без пароля",
  "email": "nopass@example.com"
}

### Создание с невалидной ролью (ожидаем 400)
POST {{baseUrl}}/api/users
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Странный",
  "email": "weird@example.com",
  "password": "secret123",
  "systemRole": "SUPERUSER"
}

### Создание без токена (ожидаем 401)
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Без токена",
  "email": "notoken@example.com",
  "password": "secret123"
}

### Обновление пользователя (частичное)
PUT {{baseUrl}}/api/users/2
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Обновлённое имя"
}

### Обновление несуществующего (ожидаем 404)
PUT {{baseUrl}}/api/users/999
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Призрак"
}

### Обновление с пустым телом (ожидаем 400)
PUT {{baseUrl}}/api/users/2
Content-Type: application/json
Authorization: Bearer {{authToken}}

{}

### Удаление пользователя
DELETE {{baseUrl}}/api/users/3
Authorization: Bearer {{authToken}}

### Удаление несуществующего (ожидаем 404)
DELETE {{baseUrl}}/api/users/999
Authorization: Bearer {{authToken}}






###
# Roles
###

### Посмотреть роли пользователя
GET {{baseUrl}}/api/users/2/business-roles
Authorization: Bearer {{authToken}}


### Сменить системную роль
PATCH {{baseUrl}}/api/users/3/system-role
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "systemRole": "ADMIN"
}

### Назначить бизнес-роль
POST {{baseUrl}}/api/users/3/business-roles
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "businessRole": "OPERATOR"
}

### Назначить вторую роль тому же пользователю
POST {{baseUrl}}/api/users/3/business-roles
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "businessRole": "ACTOR"
}

### Проверить, что обе роли есть:
GET {{baseUrl}}/api/users/3/business-roles
Authorization: Bearer {{authToken}}

### Попробовать назначить ту же роль повторно
POST {{baseUrl}}/api/users/3/business-roles
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "businessRole": "OPERATOR"
}

### Снять роль
DELETE {{baseUrl}}/api/users/3/business-roles/ACTOR
Authorization: Bearer {{authToken}}

### Попробовать снять несуществующую роль
DELETE {{baseUrl}}/api/users/3/business-roles/ACTOR
Authorization: Bearer {{authToken}}






###
# QUESTS
###

### Все квесты
GET {{baseUrl}}/api/quests
Authorization: Bearer {{authToken}}

### Один квест по id
GET {{baseUrl}}/api/quests/1
Authorization: Bearer {{authToken}}

### Несуществующий квест (ожидаем 404)
GET {{baseUrl}}/api/quests/999
Authorization: Bearer {{authToken}}

### Создание квеста
POST {{baseUrl}}/api/quests
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Побег из тюрьмы",
  "description": "Классический квест на 60 минут для команды из 4 человек"
}

### Создание без title (ожидаем 400)
POST {{baseUrl}}/api/quests
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "description": "Без названия"
}

### Обновление квеста (частичное)
PUT {{baseUrl}}/api/quests/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Побег из тюрьмы (обновлено)"
}

### Обновление несуществующего (ожидаем 404)
PUT {{baseUrl}}/api/quests/999
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Призрак"
}

### Удаление квеста
DELETE {{baseUrl}}/api/quests/3
Authorization: Bearer {{authToken}}



### Все слоты
GET {{baseUrl}}/api/slots
Authorization: Bearer {{authToken}}

### Один слот
GET {{baseUrl}}/api/slots/1
Authorization: Bearer {{authToken}}

### Создание слота
POST {{baseUrl}}/api/slots
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "time": "08:00",
  "order": 0,
  "isActive": true
}

### Создание с невалидным временем (ожидаем 400)
POST {{baseUrl}}/api/slots
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "time": "25:99",
  "order": 1
}

### Обновление слота
PUT {{baseUrl}}/api/slots/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "isActive": false
}

### Удаление слота (не используется в квестах)
DELETE {{baseUrl}}/api/slots/8
Authorization: Bearer {{authToken}}

### Удаление слота, используемого в квестах (ожидаем 409)
DELETE {{baseUrl}}/api/slots/1
Authorization: Bearer {{authToken}}






### Слоты квеста «Побег из тюрьмы» (id 5)
GET {{baseUrl}}/api/quests/5/slots
Authorization: Bearer {{authToken}}

### Слоты несуществующего квеста (ожидаем 404)
GET {{baseUrl}}/api/quests/999/slots
Authorization: Bearer {{authToken}}

### Заменить сетку слотов (только 4 слота)
PUT {{baseUrl}}/api/quests/5/slots
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "slotIds": [1, 2, 3, 4]
}

### Проверить, что сетка обновилась
GET {{baseUrl}}/api/quests/5/slots
Authorization: Bearer {{authToken}}

### Вернуть все 7 слотов
PUT {{baseUrl}}/api/quests/5/slots
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "slotIds": [1, 2, 3, 4, 5, 6, 7]
}

### Несуществующий slotId (ожидаем 400)
PUT {{baseUrl}}/api/quests/1/slots
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "slotIds": [1, 999]
}

### Пустой массив (очистить сетку)
PUT {{baseUrl}}/api/quests/1/slots
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "slotIds": []
}

### Без токена (ожидаем 401)
GET {{baseUrl}}/api/quests/1/slots

### Без админских прав (ожидаем 403)
PUT {{baseUrl}}/api/quests/1/slots
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "slotIds": [1]
}







### Квесты пользователя «Оператор» (id 3)
GET {{baseUrl}}/api/users/10/quests
Authorization: Bearer {{authToken}}

### Квесты несуществующего пользователя (ожидаем 404)
GET {{baseUrl}}/api/users/999/quests
Authorization: Bearer {{authToken}}

### Заменить набор квестов (только «Побег»)
PUT {{baseUrl}}/api/users/10/quests
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "questIds": [5]
}

### Проверить, что набор обновился
GET {{baseUrl}}/api/users/10/quests
Authorization: Bearer {{authToken}}

### Вернуть оба квеста
PUT {{baseUrl}}/api/users/10/quests
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "questIds": [5, 6]
}

### Несуществующий questId (ожидаем 400)
PUT {{baseUrl}}/api/users/10/quests
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "questIds": [1, 999]
}

### Очистить набор квестов
PUT {{baseUrl}}/api/users/3/quests
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "questIds": []
}

### Без админских прав (ожидаем 403)
PUT {{baseUrl}}/api/users/3/quests
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "questIds": [1]
}




### Получить настройки
GET {{baseUrl}}/api/settings
Authorization: Bearer {{authToken}}

### Обновить настройки (горизонт 30 дней)
PUT {{baseUrl}}/api/settings
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "availabilityHorizonDays": 30
}

### Вернуть 14 дней
PUT {{baseUrl}}/api/settings
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "availabilityHorizonDays": 14
}

### Слишком большое значение (ожидаем 400)
PUT {{baseUrl}}/api/settings
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "availabilityHorizonDays": 365
}

### Ноль (ожидаем 400)
PUT {{baseUrl}}/api/settings
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "availabilityHorizonDays": 0
}

### Не число (ожидаем 400)
PUT {{baseUrl}}/api/settings
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "availabilityHorizonDays": "много"
}

### Без админских прав (ожидаем 403)
PUT {{baseUrl}}/api/settings
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "availabilityHorizonDays": 30
}








### авторизация под оператором
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "operator@example.com",
  "password": "secret123"
}


### Извлекаем токен из ответа логина
@operatorToken = {{login.response.body.accessToken}}


### Моя доступность (Оператор, квест «Побег», 3 дня)
GET {{baseUrl}}/api/availability/me?questId=5&from=2026-10-08&to=2026-10-10
Authorization: Bearer {{operatorToken}}

### Сохранить доступность
PUT {{baseUrl}}/api/availability/me
Content-Type: application/json
Authorization: Bearer {{operatorToken}}

{
  "items": [
    { "questId": 5, "slotId": 1, "date": "2026-10-08", "canWork": true },
    { "questId": 5, "slotId": 2, "date": "2026-10-08", "canWork": false },
    { "questId": 5, "slotId": 4, "date": "2026-10-08", "canWork": true }
  ]
}

### Проверить, что сохранилось
GET {{baseUrl}}/api/availability/me?questId=5&from=2026-10-08&to=2026-10-08
Authorization: Bearer {{operatorToken}}

### Квест, на котором не работаю (ожидаем 403)
PUT {{baseUrl}}/api/availability/me
Content-Type: application/json
Authorization: Bearer {{actorToken}}

{
  "items": [
    { "questId": 2, "slotId": 3, "date": "2026-10-08", "canWork": true }
  ]
}

### Слот не из сетки квеста (ожидаем 400)
PUT {{baseUrl}}/api/availability/me
Content-Type: application/json
Authorization: Bearer {{operatorToken}}

{
  "items": [
    { "questId": 5, "slotId": 7, "date": "2026-10-08", "canWork": true }
  ]
}

### Дата в прошлом (ожидаем 400)
PUT {{baseUrl}}/api/availability/me
Content-Type: application/json
Authorization: Bearer {{operatorToken}}

{
  "items": [
    { "questId": 5, "slotId": 1, "date": "2020-01-01", "canWork": true }
  ]
}

### Дата за горизонтом (ожидаем 400)
PUT {{baseUrl}}/api/availability/me
Content-Type: application/json
Authorization: Bearer {{operatorToken}}

{
  "items": [
    { "questId": 5, "slotId": 1, "date": "2027-01-01", "canWork": true }
  ]
}





###
# HEALTH
###

### Проверка, что сервер жив
GET {{baseUrl}}/health