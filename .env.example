DATABASE_URL="postgresql://[имя_пользователя]:[пароль_от_базы]@[адрес_и_порт]/[имя_БД]?schema=public"

# postgresql:// — протокол (без + и без prisma+postgres, просто чистый Postgres).
# [имя_пользователя] (postgres) — имя пользователя (по умолчанию).
# [пароль_от_базы] — ваш пароль из docker run.
# [адрес_и_порт] (например, localhost:5433) — адрес и порт, куда мы пробросили контейнер (-p 5433:5432).
# [имя_БД] (например quest_crm) — имя БД, которое мы задали через POSTGRES_DB.
# ?schema=public — схема по умолчанию.

JWT_ACCESS_SECRET="ACCESS_SECRET"
JWT_REFRESH_SECRET="REFRESH_SECRET"
ACCESS_TOKEN_EXPIRES="15m"
REFRESH_TOKEN_EXPIRES_DAYS="7"
COOKIE_SECURE="false"

# COOKIE_SECURE=false для локальной разработки (без HTTPS). В продакшене — true

 